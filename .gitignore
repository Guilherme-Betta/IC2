# Ignorar pastas de dados e documentos que não são código-fonte
Dados/
Projeto/
Relatório/
Reuniões/

# pycache
__pycache__/

# Ignorar o ambiente virtual do Python (MUITO IMPORTANTE)
.venv/

# Ignorar outras pastas
.vscode/
.temp/
.archives/

# Opcional: ignorar tipos de arquivo específicos que podem ser gerados
# como planilhas de resultados, logs, etc.
*.log

# Ignorar atalhos do Google Drive
*.gdoc
*.gsheet
*.gslides
*.gdraw