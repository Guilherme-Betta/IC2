import pandas as pd
import numpy as np
import os
from openpyxl import load_workbook
from datetime import datetime

### Carregamento do arquivo de interesse

arquivo_entrada = input("Insira o caminho da Pasta: ") # Gera uma prompt para o usuário inserir o diretório do arquivo que será alterado
arquivo_entrada = arquivo_entrada.strip('"').replace('\\', '/') # Altera o texto inserido para que o python consiga ler

dadosBrutos = pd.ExcelFile(arquivo_entrada) # Acho que isso faz o python identificar o arquivo

dadosBrutos = pd.read_excel(arquivo_entrada) # Acho que isso faz o python ler o arquivo

### Converter Coluna de Estatística em 3 colunas para cada variável

variaveis = [col for col in dadosBrutos.columns if col not in 'Data' + 'Estatistica']   # Separa as colunas de variaveis (que serao alteradas) das colunas de data e estatística

dadosBrutos = dadosBrutos.pivot(index="Data", columns='Estatistica', values=variaveis)  # Mantem a coluna de datas como indice, converte a coluna de estatiticas em 3 colunas para cada variavel

dadosBrutos.columns = [f"{var}_{est}" for var, est in dadosBrutos.columns]  # A linha acima criou uma linha adicional com as estatisticas, repetindo 3 colunas para/
                                                                            # cada variavel. Essa linha combina a linha de variaveis com a de estatisticas, e as nomeia/
                                                                            # combinando o nome da variavel com o nome da estatistica, mas separando cada nome por um "_"/
                                                                            # Exemplo: "pH" + "Max" = "pH_Max"
### Criar um arquivo de saida 

pasta_saida = input("Insira o caminho de onde deseja salvar o arquivo: ") # Cria um input para o usuario escolher onde salvar o arquivo
pasta_saida = pasta_saida.strip('"').replace('\\', '/') 

os.makedirs(pasta_saida, exist_ok=True)   # 

nome_arquivo = f"dadosBrutosProntos_{datetime.now().strftime('%Y%m%d_%H%M%S')}.xlsx" # Gera o nome do arquivo de saida com timestamp de quando foi criado

caminho_saida = os.path.join(pasta_saida, nome_arquivo)  # Gera o caminho de saida para o arquivo

dadosBrutos.to_excel(caminho_saida, engine='openpyxl', index=True)  # Gera o arquivo de saida

print(f"Arquivo salvo em: {caminho_saida}") # Gera uma mensagem para o usuario informando sobre onde o arquivo foi salvo