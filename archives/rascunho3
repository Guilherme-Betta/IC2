import pandas as pd
import numpy as np
from lifelines import KaplanMeierFitter

# 1. Simulando o seu dataframe importado (onde a coluna é lida como string)
dados = {'E_Coli': ['3000', '4500', '>8000', '5000', '>8000', '9000']}
df = pd.DataFrame(dados)

print("Tipos de dados originais:\n", df.dtypes) # Será 'object' (string)

# 2. Criando o indicador de "Evento Observado"
# Se a string contém '>', significa que FOI censurado (portanto, evento = False/0)
# Se NÃO contém '>', o valor é exato (portanto, evento = True/1)
df['evento_observado'] = ~df['E_Coli'].str.contains('>', na=False)

# 3. Limpando a coluna original para extrair apenas os números
# Substituímos o '>' por nada e convertemos a coluna para float
df['E_Coli_numerico'] = df['E_Coli'].str.replace('>', '').astype(float)

print("\nDataframe pronto para o lifelines:")
print(df)

# 4. Agora é só rodar o Kaplan-Meier normalmente (como mostrado anteriormente)
kmf = KaplanMeierFitter()
kmf.fit(durations=df['E_Coli_numerico'], event_observed=df['evento_observado'])
print(f"\nMediana ajustada (Kaplan-Meier): {kmf.median_survival_time_}")